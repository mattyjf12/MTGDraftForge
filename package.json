    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/react-native-reanimated/android/CMakeLists.txt',c=fs.readFileSync(p,'utf8');if(!c.includes('-Wno-vla-cxx-extension')){fs.writeFileSync(p,c.replace('-Wall -Werror\\\"','-Wall -Werror -Wno-vla-cxx-extension -Wno-deprecated-this-capture\\\"'));console.log('Patched reanimated CMakeLists.txt for NDK r27')}\""
  },
