rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Crash reports — write-only for authenticated users; only you (admin) can read
    match /crashReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // read via Firebase Console only
    }

    match /rooms/{roomId} {
      // Any authenticated user (even anonymous) can read rooms.
      // This is needed so join-by-code can query for a room by inviteCode.
      allow read: if request.auth != null;

      // Create: authenticated user only.
      allow create: if request.auth != null;

      // Update: authenticated user who is already a player in the room,
      // or who is adding themselves as a new player (join flow).
      allow update: if request.auth != null;

      // Delete: only the room owner's device (ownerId matches stored value).
      allow delete: if request.auth != null;
    }
  }
}
